# Executor image (default): Red Hat UBI 9 minimal. OS, Python 3.12 and every browser library
# come from the UBI 9 repos; only Playwright's pinned headless-shell Chromium is taken from the
# official Playwright image. Playwright does not officially support RHEL; Containerfile.playwright
# is the supported Ubuntu variant. Build from the repo root after `make wheelhouse`
# (see deploy/README.md). Air-gapped: pass both images from the internal mirror, pinned by
# digest, and give the build access to a UBI 9 repo mirror (or build on the connected side).
ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.8-1790754119@sha256:1d7c5517a4a1a8e2688620b39ee980e82505ca1ab7ae5541b5463120ae9b3897

# The executor always launches headless, which Playwright serves from the headless shell; the
# full browsers are left behind. The revision follows the playwright pin, hence the glob.
FROM ${PLAYWRIGHT_IMAGE} AS browsers
RUN mkdir /browsers && cp -a /ms-playwright/chromium_headless_shell-* /browsers/

FROM ${BASE_IMAGE}
# Shared libraries chromium_headless_shell links against, plus fontconfig and one font family.
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
        python3.12 python3.12-pip \
        nss nspr glib2 dbus-libs atk at-spi2-atk at-spi2-core expat \
        libX11 libXcomposite libXdamage libXext libXfixes libXrandr libxcb libxkbcommon \
        mesa-libgbm libdrm alsa-lib systemd-libs \
        fontconfig dejavu-sans-fonts \
    && microdnf clean all

COPY --from=browsers /browsers /ms-playwright

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PIP_NO_INDEX=1 \
    PIP_ROOT_USER_ACTION=ignore \
    SYNMON_JOURNEYS_DIR=/journeys \
    SYNMON_SPOOL_DIR=/var/lib/synmon/spool \
    SYNMON_ARTIFACTS_DIR=/var/lib/synmon/artifacts \
    SYNMON_HEARTBEAT_PATH=/var/lib/synmon/heartbeat.json

# Offline install from the wheelhouse only: third-party wheels must match the uv.lock hashes;
# the project wheels carry the vendored web-vitals script and its Apache-2.0 LICENSE.
# Bind-mounted instead of copied, so the wheels do not end up in an image layer.
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    python3.12 -m pip install --no-cache-dir --find-links /wheelhouse --require-hashes \
        --requirement /wheelhouse/requirements.txt \
    && python3.12 -m pip install --no-cache-dir --no-deps /wheelhouse/synmon_contract-*.whl \
        /wheelhouse/synmon_executor-*.whl

USER 1000:1000
# python3 is the platform's 3.9; the executor needs the AppStream 3.12.
ENTRYPOINT ["python3.12", "-m", "synmon_executor.runner"]
