{
  "description": "The `synmon_worker` section payload: heartbeat fields + agent-computed scan counts.",
  "properties": {
    "allowlist": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowlist"
    },
    "executor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor"
    },
    "executor_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor Version"
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heartbeat At"
    },
    "journeys_failed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journeys Failed"
    },
    "journeys_run": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journeys Run"
    },
    "journeys_skipped": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journeys Skipped"
    },
    "last_run_duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Run Duration Ms"
    },
    "last_run_finished_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Run Finished At"
    },
    "last_run_started_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Run Started At"
    },
    "load_errors": {
      "items": {
        "type": "string"
      },
      "title": "Load Errors",
      "type": "array"
    },
    "not_allowed": {
      "default": 0,
      "title": "Not Allowed",
      "type": "integer"
    },
    "overflow": {
      "default": 0,
      "title": "Overflow",
      "type": "integer"
    },
    "results_found": {
      "default": 0,
      "title": "Results Found",
      "type": "integer"
    },
    "run_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Error"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unparseable": {
      "default": 0,
      "title": "Unparseable",
      "type": "integer"
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Id"
    }
  },
  "title": "WorkerHealth",
  "type": "object"
}
