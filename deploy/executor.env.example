# Non-secret executor configuration. install.sh copies this to /etc/synmon/executor.env
# (and sets SYNMON_WORKER_ID) on first install; it never overwrites an existing file.

# Logical worker identity (defaults to the short hostname if unset).
SYNMON_WORKER_ID=worker01

# The container sets the spool/artifacts/heartbeat/journeys paths; override here only if you
# remap the volumes in the Quadlet unit.
#SYNMON_JOURNEYS_DIR=/journeys

# Wall-clock budget for one run (all journeys incl. retries). Journeys not started (or cut short)
# in time are reported UNKNOWN instead of keeping an old result or counting as an outage. Keep it below the timer interval
# (default schedule: every 5 min) and below TimeoutStartSec in the unit.
SYNMON_RUN_BUDGET_S=270

# Delete failure screenshots (and traces) older than this many seconds (default: 7 days).
#SYNMON_ARTIFACT_MAX_AGE_S=604800

# Chromium's own sandbox is set by `install.sh --chromium-sandbox` in the unit (it also needs
# AddCapability=SYS_CHROOT there); do not set SYNMON_CHROMIUM_SANDBOX here.

# Debugging only: also save a Playwright trace on failure. Traces contain typed passwords and
# session cookies; unset it and delete /var/lib/synmon/artifacts/*.trace.zip when done.
#SYNMON_TRACE=1

# Do NOT put journey credentials here. Use podman secrets and a `Secret=` line in the unit
# (see deploy/synmon-executor.container).
