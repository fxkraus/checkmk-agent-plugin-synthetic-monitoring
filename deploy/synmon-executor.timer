# Triggers synmon-executor.service (generated by Quadlet from synmon-executor.container).
# TEMPLATE: deploy/install.sh substitutes @SCHEDULE@ and writes this to
# /etc/systemd/system/synmon-executor.timer (a plain timer — Quadlet does not process .timer files).
[Unit]
Description=Run the synthetic-monitoring executor on a schedule
Documentation=https://github.com/fxkraus/checkmk-synmon

[Timer]
# Fixed wall-clock cadence (not relative to the last run), so every result covers the same slice
# of time and Checkmk availability/SLA percentages equal the share of successful runs. A run
# still active at the next elapse makes that tick be skipped; keep SYNMON_RUN_BUDGET_S below
# the interval.
OnCalendar=@SCHEDULE@
AccuracySec=1s
Unit=synmon-executor.service

[Install]
WantedBy=timers.target
